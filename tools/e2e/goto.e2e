tap page.top
drawn 200
still
tap toolbar.bookmark
log bookmark added
drawn 200
still
tap toolbar.close
drawn 200
still
tap page.forward
log turn to 8:
drawn 500
still

# Page 8 bookmarked, then on to page 9
tap page.top
drawn 200
still
tap toolbar.bookmark
log bookmark added
drawn 200
still
tap toolbar.close
drawn 200
still
tap page.forward
log turn to 9:
drawn 500
still

# Page 9 bookmarked, then on to page 10
tap page.top
drawn 200
still
tap toolbar.bookmark
log bookmark added
drawn 200
still
tap toolbar.close
drawn 200
still
tap page.forward
log turn to 10:
drawn 500
still

# Page 10 bookmarked, then on to page 11
tap page.top
drawn 200
still
tap toolbar.bookmark
log bookmark added
drawn 200
still
tap toolbar.close
drawn 200
still
tap page.forward
log turn to 11:
drawn 500
still

# Page 11 bookmarked, then on to page 12
tap page.top
drawn 200
still
tap toolbar.bookmark
log bookmark added
drawn 200
still
tap toolbar.close
drawn 200
still
tap page.forward
log turn to 12:
drawn 500
