# Page 12 bookmarked, then on to page 13
tap page.top
drawn 200
still
tap toolbar.bookmark
log bookmark added
drawn 200
still
tap toolbar.close
drawn 200
still
tap page.forward
log turn to 13:
drawn 500
still

# Go To's notes from page 13: the list's next page has the twelfth bookmark
# alone, and its row jumps to page 12; the turn after it is to 13, where
# a jump that failed would have stayed, turning to 14
tap page.top
drawn 200
still
tap toolbar.goto
log screen: GoTo opened
drawn 300
still
tap goto.tab.notes
drawn 300
still
tap goto.next
drawn 300
shot goto-next
tap goto.row.0
log screen: GoTo done
drawn 500
still
tap page.forward
log turn to 13:
drawn 500
still

# On to the list's second page and back to its first, whose first row is page 1: the
# turn after it is to 2
tap page.top
drawn 200
still
tap toolbar.goto
log screen: GoTo opened
drawn 300
still
tap goto.tab.notes
drawn 300
still
tap goto.next
drawn 300
still
tap goto.prev
drawn 300
still
tap goto.row.0
log screen: GoTo done
drawn 500
still
tap page.forward
log turn to 2:
drawn 500
still
