# Every gesture the reader takes, on the test book (tools/e2e.zig plays it). Start from a
# fresh test folder: noface on its library, the book not opened before. After each
# screen opens, `still` waits for it to show: noface drops a touch that lands before.
# `drawn` budgets are about twice what a Paperwhite 12th gen takes, so a step that
# grows much slower fails.

# Opening the book from the library's hero
tap library.hero
log screen: Reader opened
drawn 600
still

# Turning: a tap on either side, and a swipe either way
tap page.forward
log turn to 2
drawn 500
still
tap page.back
log turn to 1
drawn 500
still
drag page.forward page.back 200
log turn to 2
drawn 500
still
drag page.back page.forward 200
log turn to 1
drawn 500
still

# The toolbar, from a tap at the top
tap page.top
drawn 200
shot toolbar

# Its bookmark, on and off again
tap toolbar.bookmark
log bookmark added
drawn 200
still
tap toolbar.bookmark
log bookmark removed
drawn 200
still

# A tap on the page closes it
tap toolbar.close
drawn 200
still

# The quick panel, pulled down from the top
drag page.top page.middle 300
log screen: Panel opened
drawn 200
shot panel

# A tap on the page below it closes it
tap panel.close
log screen: Panel closed
drawn 200
still

# Holding a word: "reader", on the first page's second line
hold 160 318 700
drawn 200
shot held
log screen: Card opened

# No dictionary in the test folder: not now, which leaves the word's sheet
tap card.2.1
log screen: Card done
drawn 200
still

# The sheet's Highlight: the word alone, left selected with its delete bubble
tap define.highlight
log words, saved true
drawn 500
shot highlighted

# A tap away lets it go
tap 1000 1300
drawn 200
still

# Holding and dragging highlights: the second paragraph's first line, selected too
drag 210 568 1150 568 400 700
log screen: Drag opened
log words, saved true
drawn 500
still

# Its delete bubble removes it, tapped where noface drew it
tap placed delete
log highlight removed: true
drawn 200
still

# Turning away from the page with "reader" still highlighted, and back to it: both
# turns take the gray-safe refresh, without a flash
tap page.forward
log turn to 2
drawn 500
still
tap page.back
log turn to 1
drawn 500
still

# The highlight left on "reader", chosen from Go To's notes: its page again, after
# turning away. A tap on it selects it, and its delete bubble removes it
tap page.forward
log turn to 2
drawn 500
still
tap page.top
drawn 200
still
tap toolbar.goto
log screen: GoTo opened
drawn 300
still
tap goto.tab.notes
drawn 200
still
tap goto.row.0
log screen: GoTo done
drawn 500
still
tap 160 318
log placed delete
drawn 300
shot selected
tap placed delete
log highlight removed: true
drawn 200
still

# Locking shows the book: the test book has no cover, so its title on white. Unlocking
# shows the page again
power
log screen: Lock opened
log locked, cover drawn: false
shot locked
power
log screen: Lock done by unlock
drawn 500
still

# Home, from the toolbar: the book closes, the library is back
tap page.top
drawn 200
still
tap toolbar.home
log screen: Reader done
log library render
drawn 300
shot library
