# Running mode on the test book (tools/e2e.zig plays it): turned on from Aa's Themes
# tab: its phrases, its taps, a drip let go, pausing by the button and by the middle
# column, the card, and stopping from it.
# Start from a fresh test folder: noface on its library, the book not opened before.

# Opening the book from the library's hero
tap 200 300
log screen: Reader opened
drawn 600
still

# The toolbar, its Aa sheet, the Themes tab, and the Running button under the tiles
tap 636 100
drawn 200
still
tap 696 118
drawn 400
still
tap 150 274
drawn 400
still
shot themes
tap 636 790
log running: on
log running: phrases from
still
shot running

# The phrases change on their own at the pace
wait 4000
shot later

# A contact too short for a finger, as a drop of sweat makes, moves nothing
hold 1100 900 30
log running: too short a touch
wait 1000

# A tap on the right shows the next phrase now; on the left, the one before again
tap 1100 900
log running: tap next
still
shot faster
wait 1000
tap 150 900
log running: tap back
still

# The pause button stops the phrases, and again carries on; so does the middle column
wait 1000
tap 104 1625
log running: paused
still
shot stopped
wait 1000
tap 104 1625
log running: resumed
still
wait 1000
tap 636 900
log running: paused
still
wait 1000
tap 636 900
log running: resumed
still

# The card from the top band, and Resume, which shows the whole screen again
wait 1000
tap 636 150
log screen: Card opened
still
shot card
tap 636 1376
log running: resume_running
log running: phrases from
still

# The card again, and Stop running
wait 1000
tap 636 150
log screen: Card opened
still
tap 636 1600
log running: stop
log running: off
still
shot back
