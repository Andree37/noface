# Running mode on the test book (tools/e2e.zig plays it): turned on from Aa's Themes
# tab: its phrases, its taps, a drip let go, pausing by the button and by the middle
# column, the card, and stopping from it.
# Start from a fresh test folder: noface on its library, the book not opened before.

# Opening the book from the library's hero
tap library.hero
log screen: Reader opened
drawn 600
still

# The toolbar, its Aa sheet, the Themes tab, and the Running button under the tiles
tap page.top
drawn 200
still
tap toolbar.text
drawn 400
still
tap aa.tab.themes
drawn 400
still
shot themes
tap aa.running
log running: on
log running: phrases from
still
shot running

# The phrases change on their own at the pace
wait 4000
shot later

# A contact too short for a finger, as a drop of sweat makes, moves nothing
hold running.next 30
log running: too short a touch
wait 1000

# A tap on the right shows the next phrase now; on the left, the one before again
tap running.next
log running: tap next
still
shot faster
wait 1000
tap running.back
log running: tap back
still

# The pause button stops the phrases, and again carries on; so does the middle column
wait 1000
tap running.pause
log running: paused
still
shot stopped
wait 1000
tap running.pause
log running: resumed
still
wait 1000
tap running.middle
log running: paused
still
wait 1000
tap running.middle
log running: resumed
still

# The card from the top band, over the phrases, paused; and Resume, which carries on
wait 1000
tap running.top
log screen: Card opened
still
shot card
tap card.3.0
log running: resume_running
still

# The card again, and Stop running
wait 1000
tap running.top
log screen: Card opened
still
tap card.3.2
log running: stop
log running: off
still
shot back

# Running again, and from the card its text settings: the toolbar over the page, shown
# once, whole, with the Themes sheet's button stopping running. Aa opens on the tab it
# was left on, Themes
tap page.top
drawn 200
still
tap toolbar.text
drawn 400
still
tap aa.running
log running: on
still
wait 1000
tap running.top
log screen: Card opened
still
tap card.3.1
log running: text_settings
still
shot settings
tap aa.running
log running: off
still
