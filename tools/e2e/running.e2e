# Running mode on the test book (tools/e2e.zig plays it): turned on from Aa's Themes
# tab: its phrases, its taps, a drip let go, the pause button, the pause card, and
# the dial's tap that stops it.
# Start from a fresh test folder: noface on its library, the book not opened before.

# Opening the book from the library's hero
tap 200 300
log screen: Reader opened
drawn 600
still

# The toolbar, its Aa sheet, the Themes tab, and the Running button under the tiles
tap 636 100
drawn 200
still
tap 696 118
drawn 400
still
tap 150 274
drawn 400
still
shot themes
tap 636 790
log running: on
log running: phrases from
still
shot running

# The phrases change on their own at the pace
wait 4000
shot later

# A contact too short for a finger, as a drop of sweat makes, moves nothing
hold 1100 900 30
log running: too short a touch
wait 1000

# A tap on the right shows the next phrase now; on the left, the one before again
tap 1100 900
log running: tap next
still
wait 1000
tap 150 900
log running: tap back
still

# The pause button stops the phrases, and again carries on
wait 1000
tap 104 1625
log running: paused
still
shot stopped
wait 1000
tap 104 1625
log running: resumed
still

# The pause card from the top band, and Resume, which shows the whole screen again
wait 1000
tap 636 150
log screen: Card opened
still
shot card
tap 636 1376
log running: resume_running
log running: phrases from
still

# A tap on the dial beside the minutes left stops running (the pause card's Stop does
# too: the scenarios play that)
wait 1000
tap 932 1626
log running: tap dial
log running: off
still
shot back
